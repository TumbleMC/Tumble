index e3debe8b5163de10bbb250740e4ea1a208c92282..d94566670a6a72027c7a2028e57690c350c14873 100644
--- a/src/main/resources/assets/lophine/lang/zh_cn.json
+++ b/src/main/resources/assets/lophine/lang/zh_cn.json
@@ -1638,6 +1638,8 @@
   "tumble.function.structure_generation_fixes.villages.savanna_small_farm.comment": "MC-306596:修复 savanna_small_farm 被内部地形匹配道路连接件盖住的问题。",
