From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: NatJerry <xiaomajunqwq123@outlook.com>
Date: Thu, 5 Nov 2026 23:43:06 +0800
Subject: [PATCH] Add Config of DeerFolia AFK network optimization


diff --git a/src/main/java/org/tumblemc/tumble/config/modules/optimizations/AfkNetworkConfig.java b/src/main/java/org/tumblemc/tumble/config/modules/optimizations/AfkNetworkConfig.java
new file mode 100644
index 0000000000000000000000000000000000000000..5da3ef09efd2692e66f39732303c011332bad39b
--- /dev/null
+++ b/src/main/java/org/tumblemc/tumble/config/modules/optimizations/AfkNetworkConfig.java
@@ -0,0 +1,53 @@
+package org.tumblemc.tumble.config.modules.optimizations;
+
+import cn.lunadeer.mc.deerfolia.afknetwork.AfkNetworkManager;
+import me.earthme.luminol.api.config.annotation.ConfigClassInfo;
+import me.earthme.luminol.api.config.annotation.ConfigInfo;
+import me.earthme.luminol.api.config.annotation.NeedRun;
+import me.earthme.luminol.api.config.enums.EnumConfigCategory;
+import me.earthme.luminol.api.config.enums.EnumRunnableType;
+
+
+import java.util.List;
+
+@ConfigClassInfo(category = EnumConfigCategory.OPTIMIZATIONS, name = "afk_network")
+public class AfkNetworkConfig {
+    @ConfigInfo(name = "enabled")
+    public static boolean enabled = true;
+
+    @ConfigInfo(name = "afk_threshold_ticks")
+    public static int afkThresholdTicks = 20 * 60;
+
+    @ConfigInfo(name = "afk_message_enabled")
+    public static boolean afkMessageEnabled = true;
+
+    @ConfigInfo(name = "afk_enter_message")
+    public static String afkEnterMessage = "&7[AFKNet] &eYou are now AFK. &7Tumble will temporarily suppress non-essential packets.";
+
+    @ConfigInfo(name = "afk_exit_message")
+    public static String afkExitMessage = "&7[AFKNet] &aWelcome back! &7This AFK session saved &b{saved_traffic} &7traffic, peak &b{saved_bandwidth}.";
+
+    @ConfigInfo(name = "count_look_changes_as_activity")
+    public static boolean countLookChangesAsActivity = true;
+
+    @ConfigInfo(name = "resync_on_resume")
+    public static boolean resyncOnResume = true;
+
+    @ConfigInfo(name = "stats_enabled")
+    public static boolean statsEnabled = true;
+
+    @ConfigInfo(name = "suppression_whitelist_categories")
+    public static List<String> suppressionWhitelistCategories = List.of();
+
+    @ConfigInfo(name = "max_suppressed_bytes_before_category_resync")
+    public static long maxSuppressedBytesBeforeCategoryResync = -1L;
+
+    @NeedRun(when = EnumRunnableType.ON_LOADED)
+    public void onLoaded() {
+        if (afkThresholdTicks < 1) afkThresholdTicks = 1;
+        afkEnterMessage = afkEnterMessage == null ? "" : afkEnterMessage.trim();
+        afkExitMessage = afkExitMessage == null ? "" : afkExitMessage.trim();
+        if (maxSuppressedBytesBeforeCategoryResync < -1L) maxSuppressedBytesBeforeCategoryResync = -1L;
+        AfkNetworkManager.refreshConfiguration();
+    }
+}
\ No newline at end of file
