+package cn.lunadeer.mc.deerfoliaplus.worldgen;
+
+import com.google.gson.JsonElement;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import com.mojang.logging.LogUtils;
+import net.minecraft.nbt.CompoundTag;
+import net.minecraft.nbt.NbtAccounter;
+import net.minecraft.nbt.NbtIo;
+import net.minecraft.resources.Identifier;
+import net.minecraft.server.packs.resources.Resource;
+import net.minecraft.server.packs.resources.ResourceManager;
+import org.slf4j.Logger;
+import org.tumblemc.tumble.config.modules.function.StructureGenerationFixesConfig;
+
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.InputStreamReader;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+import java.util.EnumSet;
+import java.util.HashMap;
+import java.util.HexFormat;
+import java.util.Map;
+import java.util.Set;
+import java.util.function.Predicate;
+
+/** Startup-scoped switches and conservative resource guards for vanilla structure repairs. */
+public final class StructureGenerationFixes {
+    private static final Logger LOGGER = LogUtils.getLogger();
+    private static final int MAX_RESOURCE_BYTES = 4 * 1024 * 1024;
+    private static final long MAX_NBT_BYTES = 64L * 1024 * 1024;
+    private static volatile Set<StructureRepair> active = Set.of();
+
+    private StructureGenerationFixes() {
+    }
+
+    // Tumble start - structure repair switches are driven by the Tumble config module
+    /** Templates are cached by Minecraft, so these switches are only read once at startup. */
+    public static synchronized void initialize() {
+        Set<StructureRepair> next = snapshot();
+        if (!next.isEmpty()) {
+            // A missing or malformed packaged catalog is a build error, not a reason to silently
+            // start with only some repairs enabled.
+            Catalog.DATA.templates.size();
+        }
+        active = next;
+    }
+    // Tumble end - Tumble config module
+
+    public static boolean enabled(StructureRepair repair) {
+        return active.contains(repair);
+    }
+
+    // Tumble start - map the Tumble config fields to repair switches
+    /** Captures the effective switches from the Tumble config module. */
+    public static Set<StructureRepair> snapshot() {
+        if (!StructureGenerationFixesConfig.enabled) {
+            return Set.of();
+        }
+        EnumSet<StructureRepair> result = EnumSet.noneOf(StructureRepair.class);
+        select(result, StructureGenerationFixesConfig.snowy_shepherds_house1, StructureRepair.SNOWY_SHEPHERDS_HOUSE);
+        select(result, StructureGenerationFixesConfig.plains_small_house8, StructureRepair.VILLAGE_PLAINS_SMALL_HOUSE_8);
+        select(result, StructureGenerationFixesConfig.plains_fisher_cottage1, StructureRepair.VILLAGE_PLAINS_FISHER_COTTAGE_1);
+        select(result, StructureGenerationFixesConfig.desert_tannery1, StructureRepair.VILLAGE_DESERT_TANNERY_1);
+        select(result, StructureGenerationFixesConfig.desert_large_farm1, StructureRepair.VILLAGE_DESERT_LARGE_FARM_1);
+        select(result, StructureGenerationFixesConfig.savanna_fisher_cottage1, StructureRepair.VILLAGE_SAVANNA_FISHER_COTTAGE_1);
+        select(result, StructureGenerationFixesConfig.savanna_shepherd1, StructureRepair.VILLAGE_SAVANNA_SHEPHERD_1);
+        select(result, StructureGenerationFixesConfig.savanna_animal_pen2, StructureRepair.VILLAGE_SAVANNA_ANIMAL_PEN_2);
+        select(result, StructureGenerationFixesConfig.savanna_large_farm2, StructureRepair.VILLAGE_SAVANNA_LARGE_FARM_2);
+        select(result, StructureGenerationFixesConfig.savanna_small_farm, StructureRepair.VILLAGE_SAVANNA_SMALL_FARM);
+        select(result, StructureGenerationFixesConfig.hay_pile, StructureRepair.VILLAGE_HAY_PILE);
+        select(result, StructureGenerationFixesConfig.pumpkin_pile, StructureRepair.VILLAGE_PUMPKIN_PILE);
+        select(result, StructureGenerationFixesConfig.ice_pile, StructureRepair.VILLAGE_ICE_PILE);
+        select(result, StructureGenerationFixesConfig.melon_pile, StructureRepair.VILLAGE_MELON_PILE);
+        select(result, StructureGenerationFixesConfig.snow_pile, StructureRepair.VILLAGE_SNOW_PILE);
+        select(result, StructureGenerationFixesConfig.group_upper1, StructureRepair.TRAIL_RUINS_GROUP_UPPER_1);
+        select(result, StructureGenerationFixesConfig.group_upper2, StructureRepair.TRAIL_RUINS_GROUP_UPPER_2);
+        select(result, StructureGenerationFixesConfig.group_upper3, StructureRepair.TRAIL_RUINS_GROUP_UPPER_3);
+        select(result, StructureGenerationFixesConfig.group_upper4, StructureRepair.TRAIL_RUINS_GROUP_UPPER_4);
+        select(result, StructureGenerationFixesConfig.group_upper5, StructureRepair.TRAIL_RUINS_GROUP_UPPER_5);
+        select(result, StructureGenerationFixesConfig.road_end1, StructureRepair.TRAIL_RUINS_ROAD_END);
+        select(result, StructureGenerationFixesConfig.corridor_wall, StructureRepair.TRIAL_CORRIDOR_WALL);
+        select(result, StructureGenerationFixesConfig.walkway_with_bridge1, StructureRepair.TRIAL_WALKWAY_BRIDGE);
+        select(result, StructureGenerationFixesConfig.chamber_disposal8, StructureRepair.TRIAL_CHAMBER_8_DISPOSAL);
+        select(result, StructureGenerationFixesConfig.pathway_end_wall0, StructureRepair.BASTION_PATHWAY_WALL);
+        select(result, StructureGenerationFixesConfig.intact_horizontal_wall_bridge, StructureRepair.ANCIENT_CITY_WALL_BRIDGE);
+        select(result, StructureGenerationFixesConfig.camp1, StructureRepair.ANCIENT_CITY_CAMP_1);
+        select(result, StructureGenerationFixesConfig.camp2, StructureRepair.ANCIENT_CITY_CAMP_2);
+        select(result, StructureGenerationFixesConfig.camp3, StructureRepair.ANCIENT_CITY_CAMP_3);
+        select(result, StructureGenerationFixesConfig.campsite_pale_garden2, StructureRepair.PALE_GARDEN_CAMPSITE_2);
+        select(result, StructureGenerationFixesConfig.campsite_old_growth_pine_taiga1, StructureRepair.CAMP_OLD_GROWTH_PINE_TAIGA_1_TREE);
+        select(result, StructureGenerationFixesConfig.campsite_old_growth_spruce_taiga4, StructureRepair.CAMP_OLD_GROWTH_SPRUCE_TAIGA_4_TREE);
+        select(result, StructureGenerationFixesConfig.campsite_snowy_taiga3, StructureRepair.CAMP_SNOWY_TAIGA_3_TREE);
+        select(result, StructureGenerationFixesConfig.tent_cherry_grove1, StructureRepair.TENT_CHERRY_GROVE_1_TREE);
+        select(result, StructureGenerationFixesConfig.tent_dappled_forest1, StructureRepair.TENT_DAPPLED_FOREST_1_TREE);
+        select(result, StructureGenerationFixesConfig.tent_dappled_forest2, StructureRepair.TENT_DAPPLED_FOREST_2_TREE);
+        select(result, StructureGenerationFixesConfig.tent_dappled_forest3, StructureRepair.TENT_DAPPLED_FOREST_3_TREE);
+        select(result, StructureGenerationFixesConfig.tent_dappled_forest4, StructureRepair.TENT_DAPPLED_FOREST_4_TREE);
+        select(result, StructureGenerationFixesConfig.tent_dappled_forest6, StructureRepair.TENT_DAPPLED_FOREST_6_TREE);
+        select(result, StructureGenerationFixesConfig.tent_savanna1, StructureRepair.TENT_SAVANNA_1_TREE);
+        select(result, StructureGenerationFixesConfig.tent_snowy_taiga10, StructureRepair.TENT_SNOWY_TAIGA_10_TREE);
+        select(result, StructureGenerationFixesConfig.tent_taiga2, StructureRepair.TENT_TAIGA_2_TREE);
+        select(result, StructureGenerationFixesConfig.tent_taiga7, StructureRepair.TENT_TAIGA_7_TREE);
+        select(result, StructureGenerationFixesConfig.tent_windswept_forest6, StructureRepair.TENT_WINDSWEPT_FOREST_6_TREE);
+        return Set.copyOf(result);
+    }
+    // Tumble end - Tumble config module
+
+    private static void select(Set<StructureRepair> result, boolean enabled, StructureRepair repair) {
+        if (enabled) {
+            result.add(repair);
+        }
+    }
+
+    public static InputStream openTemplate(Identifier id, Resource resource, ResourceManager resources) throws IOException {
+        Set<StructureRepair> settings = active;
+        if (settings.isEmpty()) {
+            return resource.open();
+        }
+        return openTemplate(id, resource, resources, settings::contains);
+    }
+
+    static InputStream openTemplate(Identifier id, Resource resource, ResourceManager resources,
+                                    Predicate<StructureRepair> enabled) throws IOException {
+        StructureRepair repair = Catalog.DATA.templates.get(id);
+        if (repair == null || !enabled.test(repair) || !isVanillaResource(resource)) {
+            return resource.open();
+        }
+        byte[] original;
+        try (InputStream input = resource.open()) {
+            original = input.readNBytes(MAX_RESOURCE_BYTES + 1);
+        }
+        if (original.length > MAX_RESOURCE_BYTES) {
+            return resource.open();
+        }
+        Baseline baseline = Catalog.DATA.resources.get(templateResource(id));
+        if (baseline == null || !baseline.matches(original)) {
+            return new ByteArrayInputStream(original);
+        }
+        // Original feature/placed-feature/provider resources are checked as well as the NBT.
+        // A data pack can change tree semantics without replacing the structure itself.
+        for (Identifier dependency : TreeStructureRepairs.dependencies(id)) {
+            if (!matchesVanillaResource(resources, dependency)) {
+                return new ByteArrayInputStream(original);
+            }
+        }
+        try {
+            CompoundTag input = NbtIo.readCompressed(new ByteArrayInputStream(original), NbtAccounter.create(MAX_NBT_BYTES));
+            CompoundTag output = StructureTemplateRepairs.apply(id, input, enabled);
+            output = TreeStructureRepairs.apply(id, output, enabled);
+            if (output == input) {
+                return new ByteArrayInputStream(original);
+            }
+            ByteArrayOutputStream result = new ByteArrayOutputStream(original.length);
+            NbtIo.writeCompressed(output, result);
+            return new ByteArrayInputStream(result.toByteArray());
+        } catch (IOException | RuntimeException exception) {
+            LOGGER.warn("Could not apply structure generation repair to {}; using its original template", id, exception);
+            return new ByteArrayInputStream(original);
+        }
+    }
+
+    private static Identifier templateResource(Identifier id) {
+        return Identifier.fromNamespaceAndPath(id.getNamespace(), "structure/" + id.getPath() + ".nbt");
+    }
+
+    /** A pack's display ID alone does not establish that it is the built-in Minecraft core. */
+    public static boolean isVanillaResource(Resource resource) {
+        return "vanilla".equals(resource.sourcePackId()) && resource.knownPackInfo()
+                .filter(pack -> "minecraft".equals(pack.namespace()) && "core".equals(pack.id())).isPresent();
+    }
+
+    /** No cache: resource reloads must immediately invalidate changed data-pack dependencies. */
+    public static boolean matchesVanillaResource(ResourceManager resources, Identifier id) {
+        Baseline baseline = Catalog.DATA.resources.get(id);
+        if (baseline == null) {
+            return false;
+        }
+        Resource resource = resources.getResource(id).orElse(null);
+        if (resource == null || !isVanillaResource(resource)) {
+            return false;
+        }
+        try (InputStream input = resource.open()) {
+            // NBT has an exact baseline size; JSON may be reformatted by the fork's resource build.
+            int limit = baseline instanceof NbtBaseline nbt ? nbt.bytes : MAX_RESOURCE_BYTES;
+            byte[] bytes = input.readNBytes(limit + 1);
+            return bytes.length <= limit && baseline.matches(bytes);
+        } catch (IOException | RuntimeException exception) {
+            return false;
+        }
+    }
+
+    private sealed interface Baseline permits NbtBaseline, JsonBaseline {
+        boolean matches(byte[] input);
+    }
+
+    private record NbtBaseline(String sha256, int bytes) implements Baseline {
+        @Override
+        public boolean matches(byte[] input) {
+            if (input.length != bytes) {
+                return false;
+            }
+            try {
+                return sha256.equals(HexFormat.of().formatHex(MessageDigest.getInstance("SHA-256").digest(input)));
+            } catch (NoSuchAlgorithmException impossible) {
+                throw new AssertionError("SHA-256 is required by the Java runtime", impossible);
+            }
+        }
+    }
+
+    private record JsonBaseline(JsonElement value) implements Baseline {
+        @Override
+        public boolean matches(byte[] input) {
+            return value.equals(JsonParser.parseString(new String(input, StandardCharsets.UTF_8)));
+        }
+    }
+
+    private record CatalogData(Map<Identifier, StructureRepair> templates, Map<Identifier, Baseline> resources) {
+    }
+
+    private static final class Catalog {
+        private static final CatalogData DATA = load();
+
+        private static CatalogData load() {
+            String path = "/deerfoliaplus/structure-generation-fixes-baseline.json";
+            try (InputStream input = StructureGenerationFixes.class.getResourceAsStream(path)) {
+                if (input == null) {
+                    throw new IOException("Missing " + path);
+                }
+                JsonObject root = JsonParser.parseReader(new InputStreamReader(input, StandardCharsets.UTF_8)).getAsJsonObject();
+                Map<Identifier, StructureRepair> templates = new HashMap<>();
+                root.getAsJsonObject("templates").entrySet().forEach(entry -> templates.put(
+                        Identifier.parse(entry.getKey()), StructureRepair.valueOf(entry.getValue().getAsString())));
+                Map<Identifier, Baseline> resources = new HashMap<>();
+                root.getAsJsonObject("resources").entrySet().forEach(entry -> {
+                    JsonObject value = entry.getValue().getAsJsonObject();
+                    Baseline baseline = switch (value.get("kind").getAsString()) {
+                        case "nbt" -> new NbtBaseline(value.get("sha256").getAsString(), value.get("bytes").getAsInt());
+                        case "json" -> new JsonBaseline(value.get("value"));
+                        default -> throw new IllegalArgumentException("Unknown structure baseline kind for " + entry.getKey());
+                    };
+                    resources.put(Identifier.parse(entry.getKey()), baseline);
+                });
+                for (Identifier id : templates.keySet()) {
+                    if (!(resources.get(templateResource(id)) instanceof NbtBaseline)) {
+                        throw new IllegalArgumentException("Missing NBT baseline for " + id);
+                    }
+                }
+                return new CatalogData(Map.copyOf(templates), Map.copyOf(resources));
+            } catch (IOException | RuntimeException exception) {
+                throw new IllegalStateException("Could not load the structure generation repair baselines", exception);
+            }
+        }
+    }
+}
