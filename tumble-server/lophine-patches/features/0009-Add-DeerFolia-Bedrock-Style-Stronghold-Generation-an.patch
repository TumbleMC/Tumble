From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: NatJerry <xiaomajunqwq123@outlook.com>
Date: Sat, 7 Nov 2026 14:21:59 +0800
Subject: [PATCH] Add DeerFolia Bedrock-Style Stronghold Generation and Keep
 Vanilla Ring Config


diff --git a/src/main/java/org/tumblemc/tumble/config/modules/function/BedrockStrongholdConfig.java b/src/main/java/org/tumblemc/tumble/config/modules/function/BedrockStrongholdConfig.java
new file mode 100644
index 0000000000000000000000000000000000000000..49000ccde5f1ecf639c7ade94135a69917f32b11
--- /dev/null
+++ b/src/main/java/org/tumblemc/tumble/config/modules/function/BedrockStrongholdConfig.java
@@ -0,0 +1,35 @@
+package org.tumblemc.tumble.config.modules.function;
+
+import me.earthme.luminol.api.config.annotation.ConfigClassInfo;
+import me.earthme.luminol.api.config.annotation.ConfigInfo;
+import me.earthme.luminol.api.config.annotation.DoNotLoad;
+import me.earthme.luminol.api.config.annotation.NeedRun;
+import me.earthme.luminol.api.config.enums.EnumConfigCategory;
+import me.earthme.luminol.api.config.enums.EnumLoadType;
+import me.earthme.luminol.api.config.enums.EnumRunnableType;
+
+@ConfigClassInfo(category = EnumConfigCategory.FUNCTION, name = "bedrock_stronghold")
+public class BedrockStrongholdConfig {
+    @DoNotLoad(when = EnumLoadType.RELOAD)
+    @ConfigInfo(name = "enabled")
+    public static boolean enabled = false;
+
+    @DoNotLoad(when = EnumLoadType.RELOAD)
+    @ConfigInfo(name = "spacing")
+    public static int spacing = 48;
+
+    @DoNotLoad(when = EnumLoadType.RELOAD)
+    @ConfigInfo(name = "separation")
+    public static int separation = 12;
+
+    @DoNotLoad(when = EnumLoadType.RELOAD)
+    @ConfigInfo(name = "keep_vanilla_rings")
+    public static boolean keep_vanilla_rings = false;
+
+    @NeedRun(when = EnumRunnableType.ON_LOADED)
+    public void onLoaded() {
+        if (spacing < 2) spacing = 2;
+        if (separation < 0) separation = 0;
+        if (separation >= spacing) separation = spacing - 1;
+    }
+}
