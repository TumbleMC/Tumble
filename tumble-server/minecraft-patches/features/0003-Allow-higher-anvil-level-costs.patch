@@ -376,6 +418,46 @@ public class AnvilMenu extends ItemCombinerMenu {
         return this.cost.get();
     }
 
+    // Tumble start - Allow higher anvil level costs
+    private int getClientCost() {
+        return Math.min(this.cost.get(), Integer.MAX_VALUE);
+    }
+
+    private boolean prepareClientAnvilCostLimitBypass() {
+        boolean shouldBypassClientLimit;
+        int actualCost = this.cost.get();
+        shouldBypassClientLimit = org.tumblemc.tumble.config.modules.function.AnvilConfig.allow_higher_levels_cost
+                && actualCost >= 40
+                && actualCost <= Integer.MAX_VALUE - 1
+                && this.getSlot(RESULT_SLOT).hasItem()
+                && this.player instanceof ServerPlayer serverPlayer
+                && serverPlayer.containerMenu == this
+                && !serverPlayer.hasInfiniteMaterials();
+        if (shouldBypassClientLimit && !this.clientAnvilCostLimitBypassed) {
+            this.setClientAnvilCostLimitBypassed(true);
+        }
+
+        return shouldBypassClientLimit;
+    }
+
+    private void finishClientAnvilCostLimitBypass(final boolean shouldBypassClientLimit) {
+        if (!shouldBypassClientLimit && this.clientAnvilCostLimitBypassed) {
+            this.setClientAnvilCostLimitBypassed(false);
+        }
+    }
+
+    private void setClientAnvilCostLimitBypassed(final boolean bypassed) {
+        if (this.clientAnvilCostLimitBypassed == bypassed) {
+            return;
+        }
+
+        this.clientAnvilCostLimitBypassed = bypassed;
+        if (this.player instanceof ServerPlayer serverPlayer) {
+            serverPlayer.onUpdateAbilities();
+        }
+    }
+    // Tumble end - Allow higher anvil level costs
+
     // CraftBukkit start
