From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ingilying <ingilying@outlook.com>
Date: Tue, 4 Aug 2026 13:41:12 +0800
Subject: [PATCH] Allow higher anvil level costs


diff --git a/net/minecraft/server/level/ServerPlayer.java b/net/minecraft/server/level/ServerPlayer.java
index 68e36ad03325cd6348dc4bbab37409b70bee6023..3f4e27c39ec6478e7b0cd582f771520264a9aae3 100644
--- a/net/minecraft/server/level/ServerPlayer.java
+++ b/net/minecraft/server/level/ServerPlayer.java
@@ -2906,7 +2906,19 @@ public class ServerPlayer extends Player implements ca.spottedleaf.moonrise.patc
     @Override
     public void onUpdateAbilities() {
         if (this.connection != null) {
-            this.connection.send(new ClientboundPlayerAbilitiesPacket(this.getAbilities()));
+            // Tumble start - Allow higher anvil level costs
+            net.minecraft.world.entity.player.Abilities clientAbilities = this.getAbilities();
+            if (this.containerMenu instanceof net.minecraft.world.inventory.AnvilMenu anvilMenu
+                && anvilMenu.clientAnvilCostLimitBypassed
+                && !clientAbilities.instabuild) {
+                net.minecraft.world.entity.player.Abilities spoofedAbilities = new net.minecraft.world.entity.player.Abilities();
+                spoofedAbilities.apply(clientAbilities.pack());
+                spoofedAbilities.instabuild = true;
+                clientAbilities = spoofedAbilities;
+            }
+
+            this.connection.send(new ClientboundPlayerAbilitiesPacket(clientAbilities));
+            // Tumble end - Allow higher anvil level costs
             this.updateInvisibilityStatus();
         }
     }
